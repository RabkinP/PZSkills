{
    "Stash_AnnotedMap": "Merkinnöin varustettu kartta",
    "Stash_MulMap1_Text1": "Täällä. Lattialaudat.",
    "Stash_MulMap1_Text2": "kirves?",
    "Stash_MulMap1_Text3": "iso väkijoukko",
    "Stash_MulMap2_Text1": "jätin sen sinulle tänne",
    "Stash_MulMap2_Text2": "säilö",
    "Stash_MulMap2_Text3": "koko naapurusto raahautui tänne",
    "Stash_MulMap3_Text1": "Haulikko ja ammuksia - kätketty muiden varalta",
    "Stash_MulMap3_Text2": "Rautatavaraa, työkaluja ja muuta sälää",
    "Stash_MulMap3_Text3": "runsaasti täällä",
    "Stash_MulMap4_Text1": "helpompi tie ulos",
    "Stash_MulMap4_Text2": "lääketarvikkeita",
    "Stash_MulMap4_Text3": "täällä se kävisi nopeasti - aivan valtavasti niitä",
    "Stash_MulMap6_Text1": "Bob, haluan että tämä paikka on linnoitettu helvetin lujaksi paluuseeni mennessä.",
    "Stash_MulMap6_Text2": "Lääketarvikkeita täällä.",
    "Stash_MulMap6_Text21": "Muista: antibiootteja, haavasiteitä. Tämä jalka ei tästä itsekseen parane.",
    "Stash_MulMap6_Text3": "Näin lauman menossa tähän suuntaan. Vältä! Rakastan sinua x",
    "Stash_MulMap7_Text1": "Suunnitelma B.",
    "Stash_MulMap7_Text2": "Kauppa – YHÄ TÄYNNÄ",
    "Stash_MulMap7_Text3": "paskana",
    "Stash_MulMap8_Text1": "Ota kamppeeni. Hautaa minut, jos turvallisesti voit. Luojan siunausta.",
    "Stash_MulMap8_Text2": "juotavaa jos tarvitset",
    "Stash_MulMap8_Text3": "iso joukkio, ei ole liikkunut päiviin",
    "Stash_MulMap10_Text1": "kuoleman talo",
    "Stash_MulMap10_Text2": "Pikaruokala Spiffo's",
    "Stash_MulMap10_Text3": "vaikutti turvalliselta alueelta",
    "Stash_MulMap11_Text1": "Ase pikaruokala Spiffo'sissa.",
    "Stash_MulMap11_Text2": "Lääkkeitä täällä.",
    "Stash_MulMap11_Text3": "vaara",
    "Stash_MulMap12_Text1": "haulikko täällä - ruokaa keittiössä?.",
    "Stash_MulMap12_Text2": "lääkesälää",
    "Stash_MulMap12_Text3": "iso joukkio",
    "Stash_MulMap13_Text1": "jätin tänne puolimatkaan - liian raskas lasti",
    "Stash_MulMap13_Text2": "rautakaupassa yhä paljon varusteita",
    "Stash_MulMap13_Text3": "laukauksia",
    "Stash_WpMap1_Text1": "Asui aika varmasti täällä",
    "Stash_WpMap1_Text2": "ihan liikaa kaadettavaksi, älä herranjumala ammu lähistölläkään",
    "Stash_WpMap2_Text1": "luulen hänen asuneen täällä",
    "Stash_WpMap2_Text2": "terveyskeskus",
    "Stash_WpMap2_Text3": "näin hänet kävelemässä täällä, ase ei mukana",
    "Stash_WpMap4_Text1": "Pysy lujana. Rakastan sinua.",
    "Stash_WpMap4_Text3": "ÄLÄ MENE TÄNNE. Megan on täällä jossain – yhtenä niistä.",
    "Stash_WpMap4_Text31": "En edes tiennyt hänen olevan kaupungissa. Anna olla",
    "Stash_WpMap5_Text1": "Pääset alkuun makkariin jättämilläni työkaluilla -",
    "Stash_WpMap5_Text11": "pidä ne loitolla niin kauan kuin pystyt RAKASTAN SINUA",
    "Stash_WpMap5_Text2": "pitsaa",
    "Stash_WpMap5_Text3": "vaara",
    "Stash_WpMap6_Text1": "En tarvitse näitä enää. Onnea matkaan.",
    "Stash_WpMap6_Text2": "Baari Twiggy's",
    "Stash_WpMap6_Text3": "maanpäällinen helvetti",
    "Stash_WpMap8_Text1": "Jolenella ei saanut tartuntaa. Hän voi auttaa.",
    "Stash_WpMap8_Text2": "Asekauppa",
    "Stash_WpMap8_Text3": "näin miehen kuolevan",
    "Stash_WpMap9_Text1": "zombipesäke",
    "Stash_WpMap9_Text2": "isän toimisto",
    "Stash_WpMap9_Text3": "isän ruumis",
    "Stash_WpMap10_Text1": "helvetillinen kaaos",
    "Stash_WpMap10_Text2": "rautakaupassa saattaa vielä olla tavaraa",
    "Stash_WpMap10_Text3": "lisää vaaroja",
    "Stash_WpMap11_Text1": "Spiffo'sin esimies säilytti liikkeessä haulikkoa.",
    "Stash_WpMap11_Text11": "Jotenkin se kaheli tiesi mitä oli tulossa.",
    "Stash_WpMap11_Text2": "Koskematon rautakauppa.",
    "Stash_WpMap11_Text3": "aion välttää kodin lähistöä - älä etsi minua täältä",
    "Stash_WpMap12_Text1": "kaikki tulivat töihin päivänä, kun kuume iski",
    "Stash_WpMap12_Text11": "Laudoitin koko paikan umpeen ennen kuin he muuttuivat",
    "Stash_WpMap12_Text2": "asekauppa",
    "Stash_WpMap12_Text3": "Black Friday -alejen kaltainen ruuhka",
    "Stash_MarchRidgeMap1_Text1": "Ase täällä",
    "Stash_MarchRidgeMap1_Text2": "kirves ja työkaluja täällä?",
    "Stash_MarchRidgeMap1_Text3": "älä mene",
    "Stash_MarchRidgeMap2_Text1": "jätin sinulle pistoolin",
    "Stash_MarchRidgeMap2_Text2": "myymälä näytti siltä, että tarvikkeita löytyy yhä",
    "Stash_MarchRidgeMap2_Text3": "vaeltavatko ne? Aivan kuin olisivat olleet matkalla tänne",
    "Stash_MarchRidgeMap3_Text1": "metsästäjän koti",
    "Stash_MarchRidgeMap3_Text2": "leipomo",
    "Stash_MarchRidgeMap3_Text3": "viimeisin paikka jossa näin hänet",
    "Stash_MarchRidgeMap4_Text1": "Jos ehdit ennen kuin muutut. Täältä löytyy jotain, mikä auttaa.",
    "Stash_MarchRidgeMap4_Text11": "Löydämme vielä toisemme. Jotenkin.",
    "Stash_MarchRidgeMap4_Text2": "Kulttuurikeskus. Ruumiini löytyy täältä. Rakastan sinua.",
    "Stash_MarchRidgeMap4_Text3": "Kunpa sinua ei olisi koskaan sijoitettu tänne. Onnellisista muistoista huolimatta.",
    "Stash_MarchRidgeMap5_Text1": "älä käytä ampuma-aseita - astaloita löytyy täältä",
    "Stash_MarchRidgeMap5_Text2": "terveyskeskus",
    "Stash_MarchRidgeMap5_Text3": "hiljaista täällä",
    "Stash_MarchRidgeMap6_Text1": "tarvikkeita barrikointiin",
    "Stash_MarchRidgeMap6_Text2": "lisää rautatavaraa",
    "Stash_MarchRidgeMap6_Text3": "maanpäällinen helvetti, osa 2",
    "Stash_MarchRidgeMap7_Text1": "Piileskeli todnäk. täällä.",
    "Stash_MarchRidgeMap7_Text2": "Sinun on luultavasti oltava työkaluja",
    "Stash_MarchRidgeMap7_Text3": "Näin hänet täällä. Ei puremaa, mutta kuume.",
    "Stash_RosewoodStashMap2_Text1": "Jemmasin tänne aseita",
    "Stash_RosewoodStashMap2_Text2": "tänne seuraavaksi",
    "Stash_RosewoodStashMap2_Text3": "lorun loppu",
    "Stash_RosewoodStashMap3_Text1": "Löysin täältä varusteita, joilla linnoittaa jokin piilopaikka turvalliseksi.",
    "Stash_RosewoodStashMap3_Text11": "Äidin koti. Nähdään siellä x",
    "Stash_RosewoodStashMap3_Text2": "täällä saattaa olla aseita - varmuuden vuoksi",
    "Stash_RosewoodStashMap3_Text3": "älä mene tähän suuntaan",
    "Stash_LVMap1_Text1": "hullu asetyyppi rip",
    "Stash_LVMap1_Text2": "asetyypin talo",
    "Stash_LVMap2_Text1": "lahja äidiltä",
    "Stash_LVMap2_Text2": "älä unohda käydä",
    "Stash_LVMap2_Text3": "isoäidin haudalla, jos voit",
    "Stash_LVMap2_Text4": "rukoile meidän kaikkien puolesta",
    "Stash_LVMap3_Text1": "koulu",
    "Stash_LVMap3_Text2": "karmivan vahtimestarin vaja",
    "Stash_LVMap3_Text3": "pitäisi olla työkaluja!",
    "Stash_LVMap4_Text1": "älä vaivaudu",
    "Stash_LVMap4_Text2": "tarvitaan leka",
    "Stash_LVMap4_Text4": "bensa-asema",
    "Stash_LVMap5_Text1": "Carlinit muuttivat tänne, Debbie",
    "Stash_LVMap5_Text2": "Mene heidän luokseen, jos tarvitset apua!",
    "Stash_LVMap5_Text3": "näimme niitä olioita",
    "Stash_LVMap5_Text4": "kaikkialla kuntosalin ympärillä",
    "Stash_LVMap5_Text5": "älä mene mihinkään yöllä!",
    "Stash_LVMap6_Text1": "OMA KOTI KULLAN KALLIS",
    "Stash_LVMap7_Text1": "Kiitos, että päästit minut kärsimyksistäni",
    "Stash_LVMap7_Text2": "Tämä oli minun taloni",
    "Stash_LVMap7_Text3": "Minulla oli kaikki tarvitsemani",
    "Stash_LVMap7_Text4": "Ainakin luulin niin",
    "Stash_LVMap8_Text1": "kadun kolmas talo",
    "Stash_LVMap8_Text2": "kiirehdi niiden pillereiden kanssa",
    "Stash_LVMap8_Text3": "NIITÄ ON TÄÄLLÄ KAIKKIALLA, ÄLÄ MENE",
    "Stash_LVMap9_Text1": "aseita ja ruokaa kauimmaisessa tallissa",
    "Stash_LVMap9_Text2": "älä eksy metsään",
    "Stash_LVMap9_Text3": "niitä on siellä",
    "Stash_LVMap10_Text1": "vanha paska, jolla on talo täynnä ruokaa",
    "Stash_LVMap10_Text2": "eikä yhtään asetta",
    "Stash_LVMap10_Text3": "älä vain tuo saatanan",
    "Stash_LVMap10_Text4": "laumaa mukanasi tällä kertaa!",
    "Stash_LVMap11_Text1": "ryöstämättä",
    "Stash_LVMap11_Text2": "täynnä tartunnan saaneita",
    "Stash_LVMap11_Text3": "säilytysyksiköt",
    "Stash_LVMap11_Text4": "LV yleinen",
    "Stash_LVMap12_Text1": "pitsanainen",
    "Stash_LVMap12_Text2": "kuuma jäbä myymässä purilaisia",
    "Stash_LVMap12_Text3": "meidän teltta",
    "Stash_LVMap12_Text4": "sinsilla tulee olemaan",
    "Stash_LVMap12_Text5": "saatanan mahtava!!!",
    "Stash_LVMap13_Text1": "hyviä turvallisia taloja",
    "Stash_LVMap13_Text2": "mutta ole varovainen takapihoja puhdistaessasi",
    "Stash_LVMap13_Text3": "",
    "Stash_LVMap14_Text1": "tee barrikadi laudoista, jotka toin sinulle",
    "Stash_LVMap14_Text2": "muuten ne pääsevät sisälle",
    "Stash_LVMap14_Text3": "älä unohda!",
    "Stash_LVMap14_Text4": "älä päästä ketään sisään, kun olen poissa!",
    "Stash_LVMap14_Text5": "Olen poissa puoli tuntia (kello on 2.30)",
    "Stash_LVMap14_Text6": "jos minulle kestää yhtään kauemmin, soita Edwardseille radiolla",
    "Stash_LVMap14_Text7": "xxxxx",
    "Stash_LVMap15_Text1": "Kuka ikinä tämän löytääkin, nimeni oli Natalie Sigmundsson,",
    "Stash_LVMap15_Text2": "taidehistorian lehtori LSU:ssa",
    "Stash_LVMap15_Text3": "Olen jo kuollut, mutta minulla on viimeinen pyyntö",
    "Stash_LVMap15_Text4": "Tämä on maailmanloppu vain, jos annamme sen olla.",
    "Stash_LVMap15_Text5": "Meidän on turvattava taidegalleriassa olevat aarteet tai",
    "Stash_LVMap15_Text6": "katoamme todella.",
    "Stash_LVMap15_Text7": "",
    "Stash_LVMap15_Text8": "Älköön kukaan sanoko, että ihmiskunta on hävinnyt lopullisesti.",
    "Stash_LVMap15_Text9": "",
    "Stash_LVMap16_Text1": "koko tämä katu on vaarallinen",
    "Stash_LVMap16_Text2": "He saivat poikasi tässä",
    "Stash_LVMap16_Text3": "tule meidän luoksemme, nyt on turvallista",
    "Stash_LVMap16_Text4": "olemme lähdössä etelään",
    "Stash_LVMap16_Text5": "tule meidän kanssamme",
    "Stash_IrvingtonMap4_Text1": "Kuinka omalaatuista ja erikoista sota onkaan",
    "Stash_MulMap14_Text1": "turvallisin talo – vahvistakaa barrikadeilla",
    "Stash_MulMap14_Text2": "kaikkialla täällä",
    "Stash_MulMap14_Text3": "älkää ampuko – äänet houkuttelevat niitä",
    "Stash_MulMap15_Text1": "vanha lääkäri",
    "Stash_MulMap15_Text2": "ole varovainen täällä",
    "Stash_MulMap15_Text21": "J sai täällä pureman",
    "Stash_MulMap16_Text1": "pankin turvamiehillä on aseet",
    "Stash_MulMap16_Text2": "Kaipaan televisiota ja kylmää kaljaa, helvetti tätä",
    "Stash_MulMap17_Text1": "zippee on täynnä tavaraa",
    "Stash_MulMap17_Text2": "tarkista myös viereinen leipomo",
    "Stash_MulMap17_Text3": "ole varovainen, äiti. Isä on vieläkin täällä",
    "Stash_MulMap18_Text1": "Hullun Willyn asuntovaunu",
    "Stash_MulMap18_Text11": "kuulin, että hän muuttui",
    "Stash_MulMap18_Text12": "toivottavasti hänen aseensa ovat edelleen siellä",
    "Stash_MulMap19_Text1": "kaikki, mitä tarvitsemme!",
    "Stash_IrvingtonMap3_Text3": "koulu",
    "Stash_WpMap13_Text1": "tappoja haulikolla: 12",
    "Stash_WpMap13_Text2": "tappoja kirveellä: 20",
    "Stash_WpMap13_Text3": "tappoja autolla: 11",
    "Stash_WpMap14_Text1": "Nähdään täällä, Tonya! Minulla on tarpeeksi ruokaa.",
    "Stash_WpMap14_Text11": "Nyt täytyy vain odottaa Colinin venettä",
    "Stash_WpMap15_Text1": "Ne eivät ikinä löydä meitä täältä, usko pois",
    "Stash_WpMap15_Text11": "ne ovat tyhmempiä kuin koiranpaska",
    "Stash_WpMap15_Text2": "Täällä on hyvä metsästää",
    "Stash_WpMap16_Text1": "Todennäköisiä hyökkäyksiä",
    "Stash_WpMap16_Text2": "Turvallisin uloskäynti",
    "Stash_WpMap16_Text21": "aita, sitten etelään metsään",
    "Stash_WpMap16_Text3": "selviytymisen todennäköisyys:",
    "Stash_WpMap16_Text31": "yksi kuukausi: 58 %%",
    "Stash_WpMap16_Text32": "talven yli: 22 %%",
    "Stash_WpMap16_Text4": "Tarvitse lisää ruokaa ja toimivan auton",
    "Stash_MarchRidgeMap8_Text1": "Jätin vanhat työkaluni tänne",
    "Stash_MarchRidgeMap8_Text2": "En tarvitse niitä enää",
    "Stash_MarchRidgeMap9_Text1": "selviytyjät ovat tervetulleita liittymään meihin – aina",
    "Stash_MarchRidgeMap9_Text2": "tarvitsemme ruokaa, aseita ja muita tavaraa",
    "Stash_MarchRidgeMap9_Text3": "tapa matkalla muutama, niin saat lisäpisteitä!",
    "Stash_MarchRidgeMap10_Text1": "Siunaus enkelille",
    "Stash_MarchRidgeMap10_Text2": "Käytä sitä demoneja vastaan",
    "Stash_RiversideStashMap1_Text1": "olemme nyt täällä",
    "Stash_RiversideStashMap1_Text11": "nähdään pian",
    "Stash_RiversideStashMap1_Text2": "ole varovainen matkalla tänne!",
    "Stash_RiversideStashMap2_Text1": "208. Odotan sinua",
    "Stash_RiversideStashMap2_Text11": "Erityinen paikkamme",
    "Stash_RiversideStashMap2_Text12": "Älä jätä minua yksin xxx",
    "Stash_RiversideStashMap3_Text1": "videovuokraamo",
    "Stash_RiversideStashMap3_Text2": "viinaa",
    "Stash_RiversideStashMap4_Text1": "daryl on sairas, jätin hänet tänne",
    "Stash_RiversideStashMap4_Text11": "natalie, hän tietää mitä tehdä",
    "Stash_RiversideStashMap4_Text2": "näin heidän nujertavan kaksi ihmistä täällä",
    "Stash_RiversideStashMap5_Text1": "ÄLÄ MENE TÄNNE",
    "Stash_RiversideStashMap5_Text2": "NE KUSIPÄÄT TAPPOIVAT FRANKIN",
    "Stash_RiversideStashMap6_Text1": "Eddiellä on täällä aseita piilossa",
    "Stash_RiversideStashMap6_Text11": "Se kusipää ottaisi vallan, jos hän ei olisi sairas",
    "Stash_RiversideStashMap6_Text12": "Toivottavasti Vickyn sekopää ei ole saanut niitä",
    "Stash_RiversideStashMap7_Text1": "kaikki muuttuivat",
    "Stash_RiversideStashMap7_Text2": "Suuntaan Gigamartiin",
    "Stash_RiversideStashMap7_Text21": "Älä riitele Junen kanssa, kun olen poissa",
    "Stash_RiversideStashMap8_Text1": "jätin sinulle tänne ruokaa",
    "Stash_RiversideStashMap8_Text11": "Syö, ennen kuin lähdet",
    "Stash_RiversideStashMap8_Text2": "",
    "Stash_RiversideStashMap8_Text3": "näin ne tässä",
    "Stash_RiversideStashMap9_Text1": "Ton odottaa meitä täällä",
    "Stash_RiversideStashMap9_Text2": "bensaa",
    "Stash_RiversideStashMap9_Text3": "D:tä purtiin – tarvitsemme antibiootteja",
    "Stash_RiversideStashMap10_Text1": "pankki",
    "Stash_RiversideStashMap10_Text2": "älä unohda vara-asetta",
    "Stash_RiversideStashMap10_Text21": "kirveesi terä näytti löysältä",
    "Stash_RiversideStashMap10_Text3": "suuntaamme pian kaupungista länteen",
    "Stash_IrvingtonMap3_Text4": "lauma",
    "Stash_RosewoodStashMap4_Text1": "Jätin tänne evakuointipakkauksen",
    "Stash_RosewoodStashMap4_Text2": "Kun ne tulevat (ja ne TULEVAT!)",
    "Stash_RosewoodStashMap4_Text3": "ota mitä voit ja suuntaa metsään",
    "Stash_RosewoodStashMap5_Text1": "ruokaa täällä",
    "Stash_RosewoodStashMap5_Text2": "Älä ryntää sisään!",
    "Stash_RosewoodStashMap5_Text3": "Muista herra Duncan",
    "Stash_BBurgMap1_Text1": "Pianonsoiton opettajan talo",
    "Stash_BBurgMap2_Text1": "monitoimitalo",
    "Stash_BBurgMap3_Text1": "Arthurin aseet?",
    "Stash_BBurgMap3_Text2": "tuhottu ravintola",
    "Stash_BBurgMap4_Text1": "äidin asuntovaunu",
    "Stash_BBurgMap4_Text2": "muista: yksikin purema = kuolema",
    "Stash_BBurgMap5_Text1": "varastoyksiköitä",
    "Stash_BBurgMap5_Text2": "baari",
    "Stash_BBurgMap6_Text1": "Minulla oli suhde Derekin kanssa",
    "Stash_BBurgMap6_Text2": "Olen pahoillani.",
    "Stash_BBurgMap7_Text1": "paskiaiset eivät päästäneet minua sisään",
    "Stash_BBurgMap7_Text2": "tapa ne kaikki!",
    "Stash_BBurgMap8_Text1": "Olive, muutin tänne Brandenburgin lähelle",
    "Stash_BBurgMap8_Text2": "Äiti oli sairas. En halunnut, että hän muuttuu",
    "Stash_BBurgMap8_Text3": "Tule tapaamaan minua",
    "Stash_BBurgMap8_Text4": "Selitän kaiken",
    "Stash_EkronStashMap1_Text1": "vanha tehdas",
    "Stash_EkronStashMap1_Text2": "työkaluja?",
    "Stash_EkronMap2_Text1": "kasviksia",
    "Stash_EkronMap3_Text1": "kamat",
    "Stash_EkronMap5_Text1": "koulu",
    "Stash_EkronMap5_Text2": "apua",
    "Stash_EkronMap5_Text3": "on liian myöhäistä, älä vaivaudu",
    "Stash_EkronMap6_Text1": "jos luet tämän",
    "Stash_EkronMap6_Text2": "tapa ihtesi!!",
    "Stash_EkronMap6_Text3": "juo valkaisuainetta horo!!",
    "Stash_EkronMap7_Text1": "ekron",
    "Stash_EkronMap8_Text1": "tie Ekroniin",
    "Stash_EkronMap8_Text2": "unohda ne! Tule vaan tänne",
    "Stash_IrvingtonMap1_Text1": "Cossette – 56,34 sekuntia",
    "Stash_IrvingtonMap1_Text2": "Dart – 1 minuutti, 14,55 sekuntia",
    "Stash_IrvingtonMap2_Text1": "Tiedän, missä asut",
    "Stash_IrvingtonMap2_Text2": "Saat vielä maksaa siitä,",
    "Stash_IrvingtonMap2_Text3": "mitä teit Annille",
    "Stash_IrvingtonMap3_Text1": "älä juokse! ne alkavat jahdata sinua",
    "Stash_IrvingtonMap3_Text2": "ota radiolla yhteyttä, jos tarvitset",
    "Stash_IrvingtonMap4_Text2": "Ammut kaverin,",
    "Stash_IrvingtonMap4_Text3": "jolle tarjoaisit, jos törmäisit häneen baarissa",
    "Stash_IrvingtonMap4_Text4": "tai antaisit puoli kruunua",
    "Stash_IrvingtonMap5_Text1": "täällä pitäisi olla ruokaa",
    "Stash_IrvingtonMap5_Text2": "ellei teresa vienyt kaikkea",
    "Stash_IrvingtonMap6_Text1": "täällä saattaa olla kamaa",
    "Stash_IrvingtonMap6_Text2": "ole kuitenkin varovainen",
    "Stash_IrvingtonMap8_Text1": "ravintola",
    "Stash_IrvingtonMap8_Text2": "pesula",
    "Stash_IrvingtonMap8_Text3": "en voi olla ainoa, joka on elossa",
    "Stash_IrvingtonMap9_Text1": "voimme linnoittaa tämän paikan",
    "Stash_IrvingtonMap9_Text2": "asiat kääntyvät parhain päin!",
