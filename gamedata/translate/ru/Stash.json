    "Stash_RosewoodStashMap5_Text1": "еда тут",
    "Stash_RosewoodStashMap5_Text2": "Не спеши!",
    "Stash_RosewoodStashMap5_Text3": "Помни про мистера Дункана",
    "Stash_WorldMap1_Text1": "Кара поможет",
    "Stash_WorldMap1_Text2": "езжай неторопясь",
