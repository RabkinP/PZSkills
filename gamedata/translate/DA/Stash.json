{
    "Stash_AnnotedMap": "",
    "Stash_LVMap1_Text1": "gal skydefyr død",
    "Stash_LVMap1_Text2": "skydefyrs hus",
    "Stash_LVMap2_Text1": "gave fra mor",
    "Stash_LVMap2_Text2": "husk at besøge",
    "Stash_LVMap2_Text3": "bedstemors grav, hvis du kan",
    "Stash_LVMap2_Text4": "bed en bøn for os alle",
    "Stash_LVMap3_Text1": "skole",
    "Stash_LVMap3_Text2": "uhyggelig pedels skur",
    "Stash_LVMap3_Text3": "skal have værktøjer!",
    "Stash_LVMap4_Text1": "tag dig ikke af det",
    "Stash_LVMap4_Text2": "brug for slæde",
    "Stash_LVMap4_Text4": "tankstation",
    "Stash_LVMap5_Text1": "Carlin-familien flyttede hertil Debbie",
    "Stash_LVMap5_Text2": "Du kan få hjælp fra dem!",
    "Stash_LVMap5_Text3": "vi så de tingester",
    "Stash_LVMap5_Text4": "i hele fitnesscentret",
    "Stash_LVMap5_Text5": "gå ingen steder om natten!",
    "Stash_LVMap6_Text1": "HJEM KÆRE HJEM",
    "Stash_LVMap7_Text1": "Tak, fordi du aflivede mig",
    "Stash_LVMap7_Text2": "Dette var mit hus",
    "Stash_LVMap7_Text3": "Jeg havde alt, jeg skulle bruge",
    "Stash_LVMap7_Text4": "Jeg troede",
    "Stash_LVMap8_Text1": "tredje dør",
    "Stash_LVMap8_Text2": "skynd dig med pillerne",
    "Stash_LVMap8_Text3": "DE ER OVERALT HER BLIV VÆK",
    "Stash_LVMap9_Text1": "våben og mad i den fjerneste stald",
    "Stash_LVMap9_Text2": "far ikke vild blandt træerne",
    "Stash_LVMap9_Text3": "de tingester er derinde",
    "Stash_LVMap10_Text1": "gammelt røvhul med huset fyldt med mad",
    "Stash_LVMap10_Text2": "og ingen våben",
    "Stash_LVMap10_Text3": "men lad være med at tage en",
    "Stash_LVMap10_Text4": "horden med dig denne gang!",
    "Stash_LVMap11_Text1": "urørt",
    "Stash_LVMap11_Text2": "fuld af inficerede",
    "Stash_LVMap11_Text3": "opbevaring",
    "Stash_LVMap11_Text4": "LV General",
    "Stash_LVMap12_Text1": "pizzadame",
    "Stash_LVMap12_Text2": "flot fyr sælger burgere",
    "Stash_LVMap12_Text3": "vores telt",
    "Stash_LVMap12_Text4": "sinsilla bliver",
    "Stash_LVMap12_Text5": "helt fantastisk!!!",
    "Stash_LVMap13_Text1": "gode sikre huse",
    "Stash_LVMap13_Text2": "men sørg for at rydde haver",
    "Stash_LVMap13_Text3": "",
    "Stash_LVMap14_Text1": "barrikadér med de planker, jeg gav dig",
    "Stash_LVMap14_Text2": "ellers kommer de ind",
    "Stash_LVMap14_Text3": "husk det!",
    "Stash_LVMap14_Text4": "luk ingen ind, mens jeg er væk!",
    "Stash_LVMap14_Text5": "det tager en halv time (14.30 nu)",
    "Stash_LVMap14_Text6": "varer det længere, kontakter du Edwards",
    "Stash_LVMap14_Text7": "xxxxx",
    "Stash_LVMap15_Text1": "Til den, der finder dette: Jeg var Natalie Sigmundsson,",
    "Stash_LVMap15_Text2": "underviser i kunsthistorie på LSU.",
    "Stash_LVMap15_Text3": "Jeg er allerede død, men har et sidste ønske.",
    "Stash_LVMap15_Text4": "Dette er kun verdens ende, hvis vi tillader det.",
    "Stash_LVMap15_Text5": "Vi må sikre skattene i galleriet, ellers",
    "Stash_LVMap15_Text6": "vi farer rigtigt vild.",
    "Stash_LVMap15_Text7": "",
    "Stash_LVMap15_Text8": "Lad ingen hævde, at menneskeheden er fortabt.",
    "Stash_LVMap15_Text9": "",
    "Stash_LVMap16_Text1": "hele gaden er farlig",
    "Stash_LVMap16_Text2": "De har din søn her",
    "Stash_LVMap16_Text3": "kom til os, det er sikkert nu",
    "Stash_LVMap16_Text4": "vi tager mod syd",
    "Stash_LVMap16_Text5": "kom med os",
    "Stash_MulMap1_Text1": "Gulvbrædder.",
    "Stash_MulMap1_Text2": "",
    "Stash_MulMap1_Text3": "stor flok",
    "Stash_MulMap2_Text1": "lagde den her xx",
    "Stash_MulMap2_Text2": "",
    "Stash_MulMap2_Text3": "",
    "Stash_MulMap3_Text1": "Haglgevær og ammunition – skjult",
    "Stash_MulMap3_Text2": "",
    "Stash_MulMap3_Text3": "meget her",
    "Stash_MulMap4_Text1": "lettere vej ud",
    "Stash_MulMap4_Text2": "lægesager",
    "Stash_MulMap4_Text3": "mange af dem",
    "Stash_MulMap6_Text1": "Bob, stedet skal være ALLERHELVEDES befæstet",
    "Stash_MulMap6_Text2": "antibiotika, bandager",
    "Stash_MulMap6_Text21": "benet bliver ikke fikset",
    "Stash_MulMap6_Text3": "Oh, jeg så en flok af dem på vej i denne retning. Undgå dem!",
    "Stash_MulMap7_Text1": "Plan B",
    "Stash_MulMap7_Text2": "Butik – FULD",
    "Stash_MulMap7_Text3": "helt smadret",
    "Stash_MulMap8_Text1": "Begrav mig – Gud velsigne jer",
    "Stash_MulMap8_Text2": "",
    "Stash_MulMap8_Text3": "stor flok, har ikke rokket sig i dagevis",
    "Stash_MulMap10_Text1": "dødshus",
    "Stash_MulMap10_Text2": "",
    "Stash_MulMap10_Text3": "vist fri bane her",
    "Stash_MulMap11_Text1": "Gevær i Spiffo's.",
    "Stash_MulMap11_Text2": "",
    "Stash_MulMap11_Text3": "problemer",
    "Stash_MulMap12_Text1": "haglgevær – mad i køkkenet?",
    "Stash_MulMap12_Text2": "",
    "Stash_MulMap12_Text3": "stor flok",
    "Stash_MulMap13_Text1": "nåede halvvejs, men måtte efterlade det hele – for tungt",
    "Stash_MulMap13_Text2": "stadig masser af grej i byggemarkedet",
    "Stash_MulMap13_Text3": "skud",
    "Stash_MulMap14_Text1": "sikreste hus – barrikadér",
    "Stash_MulMap14_Text2": "over det hele her",
    "Stash_MulMap14_Text3": "skyd ikke – lyden tiltrækker dem",
    "Stash_MulMap15_Text1": "gammel læge",
    "Stash_MulMap15_Text2": "forsigtig her",
    "Stash_MulMap15_Text21": "J blev bidt her",
    "Stash_MulMap16_Text1": "bankens vagter har våben",
    "Stash_MulMap16_Text2": "Jeg savner tv og kolde øl, skid hul i det her",
    "Stash_MulMap17_Text1": "zippees fyldt med sager",
    "Stash_MulMap17_Text2": "tjek også bageriet ved siden af",
    "Stash_MulMap17_Text3": "vær forsigtig, mor, far er her stadig",
    "Stash_MulMap18_Text1": "Skøre Willys skur",
    "Stash_MulMap18_Text11": "han er vist forvandlet",
    "Stash_MulMap18_Text12": "håber hans våben stadig er der",
    "Stash_MulMap19_Text1": "alt vi har brug for!",
    "Stash_WpMap1_Text1": "sikker på, det var her, han boede?",
    "Stash_WpMap1_Text2": "skyd den ikke her, for Guds skyld",
    "Stash_WpMap2_Text1": "hun boede vist her",
    "Stash_WpMap2_Text2": "lægeklinik",
    "Stash_WpMap2_Text3": "fandt hende, intet skydevåben",
    "Stash_WpMap4_Text1": "Vær tapper. Jeg elsker dig.",
    "Stash_WpMap4_Text3": "MEGAN ER ÉN AF DEM",
    "Stash_WpMap4_Text31": "BLIV",
    "Stash_WpMap5_Text1": "værktøjer",
    "Stash_WpMap5_Text11": "JEG ELSKER DIG",
    "Stash_WpMap5_Text2": "",
    "Stash_WpMap5_Text3": "problemer",
    "Stash_WpMap6_Text1": "Jeg får ikke brug for det her nu",
    "Stash_WpMap6_Text2": "",
    "Stash_WpMap6_Text3": "hede hule helvede",
    "Stash_WpMap8_Text1": "Jolene blev ikke syg. Hun kan hjælpe.",
    "Stash_WpMap8_Text2": "",
    "Stash_WpMap8_Text3": "så en fyr dø",
    "Stash_WpMap9_Text1": "inficeret helvede",
    "Stash_WpMap9_Text2": "",
    "Stash_WpMap9_Text3": "far",
    "Stash_WpMap10_Text1": "helt ude at skide",
    "Stash_WpMap10_Text2": "",
    "Stash_WpMap10_Text3": "flere problemer",
    "Stash_WpMap11_Text1": "Chefen hos Spiffo's beholdt haglgevær",
    "Stash_WpMap11_Text11": "idioten vidste, hvad der ventede",
    "Stash_WpMap11_Text2": "Uberørt byggemarked",
    "Stash_WpMap11_Text3": "jeg undgår mit hjem – led ikke efter mig her",
    "Stash_WpMap12_Text1": "alle på kontoret har feber",
    "Stash_WpMap12_Text11": "Jeg spærrede dem inde",
    "Stash_WpMap12_Text2": "våbenbutik",
    "Stash_WpMap12_Text3": "black friday-agtig pøbel",
    "Stash_WpMap13_Text1": "drab med haglgevær: 12",
    "Stash_WpMap13_Text2": "drab med økse: 20",
    "Stash_WpMap13_Text3": "drab med bil: 11",
    "Stash_WpMap14_Text1": "Mød mig her, Tonya! Jeg har mad nok.",
    "Stash_WpMap14_Text11": "Nu må vi vente på Colins båd",
    "Stash_WpMap15_Text1": "De finder os aldrig her, tro mig",
    "Stash_WpMap15_Text11": "de er dummere end hundelort",
    "Stash_WpMap15_Text2": "Godt sted at jage",
    "Stash_WpMap16_Text1": "Fare for angreb",
    "Stash_WpMap16_Text2": "Sikreste flugtvej",
    "Stash_WpMap16_Text21": "hegn, så syd til skoven",
    "Stash_WpMap16_Text3": "chance for at overleve:",
    "Stash_WpMap16_Text31": "en måned: 58 %%",
    "Stash_WpMap16_Text32": "hele vinteren: 22 %%",
    "Stash_WpMap16_Text4": "Skal bruge mere mad og en fungerende bil",
    "Stash_MarchRidgeMap1_Text1": "Våben her",
    "Stash_MarchRidgeMap1_Text2": "",
    "Stash_MarchRidgeMap1_Text3": "bliv",
    "Stash_MarchRidgeMap2_Text1": "lagde en pistol til dig",
    "Stash_MarchRidgeMap2_Text2": "butik havde forsyninger",
    "Stash_MarchRidgeMap2_Text3": "vandrer de?",
    "Stash_MarchRidgeMap3_Text1": "jægerfyr her",
    "Stash_MarchRidgeMap3_Text2": "bageri",
    "Stash_MarchRidgeMap3_Text3": "sidste sted jeg så hende",
    "Stash_MarchRidgeMap4_Text1": "Om du kan nå hertil, før det er din tur. Der er noget her",
    "Stash_MarchRidgeMap4_Text11": "for at hjælpe. Vi finder hinanden på en eller anden måde.",
    "Stash_MarchRidgeMap4_Text2": "Du finder mig her. Jeg elsker dig.",
    "Stash_MarchRidgeMap4_Text3": "Jeg ville ønske, du ikke var blevet udstationeret her.",
    "Stash_MarchRidgeMap5_Text1": "ting, du kan bruge som våben her",
    "Stash_MarchRidgeMap5_Text2": "lægeklinik",
    "Stash_MarchRidgeMap5_Text3": "stille her",
    "Stash_MarchRidgeMap6_Text1": "ting vi kan sikre bygningen med",
    "Stash_MarchRidgeMap6_Text2": "isenkram",
    "Stash_MarchRidgeMap6_Text3": "her er helvede blevet tømt",
    "Stash_MarchRidgeMap7_Text1": "Hvor jeg tror, han gemte sig",
    "Stash_MarchRidgeMap7_Text2": "",
    "Stash_MarchRidgeMap7_Text3": "Så ham her. Intet bid, men havde feber.",
    "Stash_MarchRidgeMap8_Text1": "Efterlod mit gamle værktøj her",
    "Stash_MarchRidgeMap8_Text2": "Skal ikke bruge dem nu",
    "Stash_MarchRidgeMap9_Text1": "overlevende må gerne være med – altid",
    "Stash_MarchRidgeMap9_Text2": "skal bruge mad og våben og sådan",
    "Stash_MarchRidgeMap9_Text3": "dræb nogle på vejen for at få respekt!",
    "Stash_MarchRidgeMap10_Text1": "Velsignelser til en engel",
    "Stash_MarchRidgeMap10_Text2": "Brug den på dæmonerne",
    "Stash_RiversideStashMap1_Text1": "vi er her nu",
    "Stash_RiversideStashMap1_Text11": "vi ses snart",
    "Stash_RiversideStashMap1_Text2": "forsigtig heromkring!",
    "Stash_RiversideStashMap2_Text1": "208. Venter på dig",
    "Stash_RiversideStashMap2_Text11": "Vores særlige sted",
    "Stash_RiversideStashMap2_Text12": "Efterlad mig ikke xxx",
    "Stash_RiversideStashMap3_Text1": "videobutik",
    "Stash_RiversideStashMap3_Text2": "sprut",
    "Stash_RiversideStashMap4_Text1": "daryl er syg, efterlod ham her",
    "Stash_RiversideStashMap4_Text11": "hent natalie, hun ved, hvad vi skal gøre",
    "Stash_RiversideStashMap4_Text2": "så dem trække to personer ned her",
    "Stash_RiversideStashMap5_Text1": "TAG IKKE HERTIL",
    "Stash_RiversideStashMap5_Text2": "RØVHULLERNE DRÆBTE FRANK",
    "Stash_RiversideStashMap6_Text1": "Eddie skydevåben skjult her",
    "Stash_RiversideStashMap6_Text11": "Svinet ville overtage, hvis han ikke var syg",
    "Stash_RiversideStashMap6_Text12": "Håber ikke, at psykopaten Vicky fik dem",
    "Stash_RiversideStashMap7_Text1": "alle forvandlet",
    "Stash_RiversideStashMap7_Text2": "Tager til Gigamart",
    "Stash_RiversideStashMap7_Text21": "Hold fred med June, mens jeg er væk",
    "Stash_RiversideStashMap8_Text1": "efterlod noget mad her",
    "Stash_RiversideStashMap8_Text11": "Spis det, før du tager afsted",
    "Stash_RiversideStashMap8_Text2": "",
    "Stash_RiversideStashMap8_Text3": "hvor jeg så dem",
    "Stash_RiversideStashMap9_Text1": "Ton venter på os her",
    "Stash_RiversideStashMap9_Text2": "benzin",
    "Stash_RiversideStashMap9_Text3": "D er blevet bidt – skal bruge antibiotika",
    "Stash_RiversideStashMap10_Text1": "bank",
    "Stash_RiversideStashMap10_Text2": "husk et ekstra våben",
    "Stash_RiversideStashMap10_Text21": "dit øksehoved ser løst ud",
    "Stash_RiversideStashMap10_Text3": "tager mod vest ud af byen snart",
    "Stash_RosewoodStashMap2_Text1": "Gemte våben",
    "Stash_RosewoodStashMap2_Text2": "her næste gang",
    "Stash_RosewoodStashMap2_Text3": "slutter lige her",
    "Stash_RosewoodStashMap3_Text1": "hjælp os med at befæste os, mens vi venter på, at det er overstået.",
    "Stash_RosewoodStashMap3_Text11": "Mors gamle hus. Vi ses der x",
    "Stash_RosewoodStashMap3_Text2": "skole",
    "Stash_RosewoodStashMap3_Text3": "gå ikke denne vej",
    "Stash_RosewoodStashMap4_Text1": "Efterlød nødudstyr her",
    "Stash_RosewoodStashMap4_Text2": "Når de kommer (og det gør de!)",
    "Stash_RosewoodStashMap4_Text3": "tag det, du kan bære, og begiv dig ind i skoven",
    "Stash_RosewoodStashMap5_Text1": "mad her",
    "Stash_RosewoodStashMap5_Text2": "Lad være med at storme ind!",
    "Stash_RosewoodStashMap5_Text3": "Husk hr. Duncan",
    "Stash_BBurgMap1_Text1": "Klaverlærerens hus",
    "Stash_BBurgMap2_Text1": "medborgerhus",
    "Stash_BBurgMap3_Text1": "Arthurs skydevåben?",
    "Stash_BBurgMap3_Text2": "smadret restaurant",
    "Stash_BBurgMap4_Text1": "mors anhænger",
    "Stash_BBurgMap4_Text2": "husk: ét bid = død",
    "Stash_BBurgMap5_Text1": "opbevaring",
    "Stash_BBurgMap5_Text2": "bar",
    "Stash_BBurgMap6_Text1": "Jeg havde en affære med Derek",
    "Stash_BBurgMap6_Text2": "Jeg beklager virkelig",
    "Stash_BBurgMap7_Text1": "svinene ville ikke lukke mig ind",
    "Stash_BBurgMap7_Text2": "dræb dem alle!",
    "Stash_BBurgMap8_Text1": "Olive, jeg er flyttet hertil i nærheden af Brandenburg",
    "Stash_WorldMap4_Text1": "Hvor Yana sagde",
    "Stash_BBurgMap8_Text2": "Mor var syg. Jeg ville ikke have, at hun skulle forvandles",
    "Stash_BBurgMap8_Text3": "Kom og besøg mig",
    "Stash_BBurgMap8_Text4": "Jeg forklarer alt",
    "Stash_EkronStashMap1_Text1": "gammel fabrik",
    "Stash_EkronStashMap1_Text2": "værktøjer?",
    "Stash_EkronMap2_Text1": "grøntsager",
    "Stash_EkronMap3_Text1": "varerne",
    "Stash_EkronMap5_Text1": "skole",
    "Stash_EkronMap5_Text2": "hjælp",
    "Stash_EkronMap5_Text3": "det er for sent, tag dig ikke af det",
    "Stash_EkronMap6_Text1": "hvis du læser dette",
    "Stash_EkronMap6_Text2": "dræb dig selv !!",
    "Stash_EkronMap6_Text3": "drik blegemiddel, kælling!!",
    "Stash_EkronMap7_Text1": "ekron",
    "Stash_EkronMap8_Text1": "vej til Ekron",
    "Stash_EkronMap8_Text2": "glem dem! Bare kom hertil",
    "Stash_IrvingtonMap1_Text1": "Cossette – 56,34 sekunder",
    "Stash_IrvingtonMap1_Text2": "Dart – 1 minut, 14,55 sekunder",
    "Stash_IrvingtonMap2_Text1": "Jeg ved, hvor du bor",
    "Stash_IrvingtonMap2_Text2": "Du kommer til at betale for",
    "Stash_IrvingtonMap2_Text3": "det, du gjorde mod Ann",
    "Stash_IrvingtonMap3_Text1": "løb ikke! De kommer efter dig",
    "Stash_IrvingtonMap3_Text2": "kontakt os på radio, hvis du er nødt til det",
    "Stash_IrvingtonMap3_Text3": "skole",
    "Stash_IrvingtonMap3_Text4": "horde",
    "Stash_IrvingtonMap4_Text1": "Hvor besynderlig og mærkværdig krig er",
    "Stash_IrvingtonMap4_Text2": "Du skyder en fyr",
    "Stash_IrvingtonMap4_Text3": "som du ville købe en drink, hvor der er en bar",
    "Stash_IrvingtonMap4_Text4": "eller hjælpe med en mønt",
    "Stash_IrvingtonMap5_Text1": "hvis der er mad her",
    "Stash_IrvingtonMap5_Text2": "medmindre teresa har taget det hele",
    "Stash_IrvingtonMap6_Text1": "er der måske stadig ting her",
    "Stash_IrvingtonMap6_Text2": "men pas på",
    "Stash_IrvingtonMap8_Text1": "restaurant",
    "Stash_IrvingtonMap8_Text2": "vasketøj",
    "Stash_IrvingtonMap8_Text3": "Jeg kan ikke være den eneste, der er tilbage",
    "Stash_IrvingtonMap9_Text1": "vi kan befæste os her",
    "Stash_IrvingtonMap9_Text2": "alt vil være i orden!",
    "Stash_IrvingtonMap10_Text1": "IRVINGTON",
    "Stash_IrvingtonMap10_Text2": "VI VIL VÆRE HER",
    "Stash_WorldMap1_Text1": "Cara vil hjælpe",
    "Stash_WorldMap1_Text2": "kør langsomt",
    "Stash_WorldMap2_Text1": "sikkert sted",
    "Stash_WorldMap2_Text11": "først barrikade!",
    "Stash_WorldMap2_Text12": "skjulte skydevåben indenfor",
    "Stash_WorldMap3_Text1": "benzin her",
    "Stash_WorldMap3_Text11": "du får brug for det",
    "Stash_WorldMap4_Text11": "kvinder lever",
    "Stash_WorldMap4_Text12": "Måske vil hun hjælpe os",
    "Stash_WorldMap5_Text1": "paulie efterlod ting her",
    "Stash_WorldMap5_Text11": "lad ikke udkigsposter se dig",
    "Stash_WorldMap5_Text12": "og brænd dette kort!!",
    "Stash_WorldMap6_Text1": "der bør være noget her",
    "Stash_WorldMap6_Text2": "kun bytte – for stort til at sikre",
    "Stash_WorldMap6_Text3": "andy",
    "Stash_WorldMap7_Text1": "fyld op her",
    "Stash_WorldMap7_Text2": "fuld af inficerede",
    "Stash_WorldMap7_Text21": "hvor kom de fra?",
    "Stash_WorldMap9_Text1": "BANEGÅRDSTERRÆN",
    "Stash_WorldMap9_Text2": "kasser over alt, kunne være fyldt med ting",
    "Stash_WorldMap9_Text3": "kontorer, intet",
    "Stash_WorldMap9_Text4": "lagre",
    "Stash_WorldMap9_Text5": "muldraugh",
    "Stash_WorldMap9_Text6": "ingen af togene kan køres???",
    "Stash_WorldMap10_Text1": "BENZIN",
    "Stash_WorldMap10_Text2": "TØJ",
    "Stash_WorldMap10_Text3": "SPIFFO'S",
    "Stash_WorldMap10_Text4": "BILER",
    "Stash_WorldMap11_Text1": "Tallerken 3 på tårn 2 – mister signal",
    "Stash_WorldMap11_Text11": "omkring 6 GHz – strømproblem",
    "Stash_WorldMap11_Text2": "Få hovedkvarteret til at teste med Lexington",
    "Stash_WorldMap12_Text1": "KÆMPE lejrpladser",
    "Stash_WorldMap12_Text11": "har alt, vi skal bruge (undtagen Janes piller)",
    "Stash_WorldMap12_Text2": "Vi skal alle sidde omkring et bål",
    "Stash_WorldMap12_Text21": "synge sange snart",
    "Stash_WorldMap13_Text1": "hal, jeg VED, det er svært",
    "Stash_WorldMap13_Text11": "men du er nødt til at gå",
    "Stash_WorldMap13_Text12": "paula – vi er kommet",
    "Stash_WorldMap14_Text1": "bedstemor",
    "Stash_WorldMap14_Text2": "far",
