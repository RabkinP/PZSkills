{
    "Stash_AnnotedMap": "Hartă Anotată",
    "Stash_MarchRidgeMap1_Text1": "Armă de foc aici",
    "Stash_MarchRidgeMap1_Text2": "topor și unelte aici?",
    "Stash_MarchRidgeMap1_Text3": "nu pleca",
    "Stash_MarchRidgeMap2_Text1": "ți-am lăsat un pistol",
    "Stash_MarchRidgeMap2_Text2": "magazinul arăta de parcă avea provizii",
    "Stash_MarchRidgeMap2_Text3": "au migrat? Pare că veneau aici",
    "Stash_MarchRidgeMap3_Text1": "vânător aici",
    "Stash_MarchRidgeMap3_Text2": "brutărie",
    "Stash_MarchRidgeMap3_Text3": "ultimul lor în care am văzut-o",
    "Stash_MarchRidgeMap4_Text1": "Dacă poți ajunge până te transformi. E nevoie de ajutor aici.",
    "Stash_MarchRidgeMap4_Text11": "Vom fi înapoi împreună. Cumva.",
    "Stash_MarchRidgeMap4_Text2": "Centrul Comunitar. Îmi vei găsi cadavrul acolo. Te iubesc.",
    "Stash_MarchRidgeMap4_Text3": "Mă rugam la Dumnezeu să fii staționat aici. Avem însă memorii frumoase aici.",
    "Stash_MarchRidgeMap5_Text1": "nu folosi puștile - aici sunt lucruri pe care le poți folosi ca arme albe",
    "Stash_MarchRidgeMap5_Text2": "clinică",
    "Stash_MarchRidgeMap5_Text3": "liniște aici",
    "Stash_MarchRidgeMap6_Text1": "lucruri pe care le putem folosi ca să fortificăm clădirea",
    "Stash_MarchRidgeMap6_Text2": "hardware suplimentar",
    "Stash_MarchRidgeMap6_Text3": "HELL EMPTIED OUT HERE",
    "Stash_MarchRidgeMap7_Text1": "Unde cred că se ascundea.",
    "Stash_MarchRidgeMap7_Text2": "Probabil vei avea nevoie să ai unelte",
    "Stash_MarchRidgeMap7_Text3": "L-am văzut aici. Nicio mușcătură, far avea febra.",
    "Stash_MulMap10_Text1": "casa morții",
    "Stash_MulMap10_Text2": "a lui Spiffo",
    "Stash_MulMap10_Text3": "părea liber pe aici",
    "Stash_MulMap11_Text1": "Arme în Spiffo's.",
    "Stash_MulMap11_Text2": "Droguri aici.",
    "Stash_MulMap11_Text3": "belele",
    "Stash_MulMap12_Text1": "pușcă aici - mâncare în bucătărie?.",
    "Stash_MulMap12_Text2": "rahaturi medicinale",
    "Stash_MulMap12_Text3": "mulțime mare",
    "Stash_MulMap13_Text1": "am ajuns la jumătatea drumului dar a trebuit să lăsăm toate astea aici - prea grele",
    "Stash_MulMap13_Text2": "sunt destule echipamente în magazinul de bricolaj",
    "Stash_MulMap13_Text3": "focuri de armă",
    "Stash_MulMap1_Text1": "Aici. Pardoseli.",
    "Stash_MulMap1_Text2": "topor?",
    "Stash_MulMap1_Text3": "mulțime mare",
    "Stash_MulMap2_Text1": "l-am lăsat aici pentru tine",
    "Stash_MulMap2_Text2": "depozit",
    "Stash_MulMap2_Text3": "tot cartierul s-a transformat pe aici",
    "Stash_MulMap3_Text1": "Pușcă și muniție - ascunde în caz că alt cineva verifică",
    "Stash_MulMap3_Text2": "Hardware, unelte și chestii",
    "Stash_MulMap3_Text3": "multe aici",
    "Stash_MulMap4_Text1": "calea ușoară",
    "Stash_MulMap4_Text2": "medical",
    "Stash_MulMap4_Text3": "va fi repede aici - sunt atât de mulți",
    "Stash_MulMap6_Text1": "Bob, vreau locul ăsta fortificat ca NAIBA de bine până mă întorc.",
    "Stash_MulMap6_Text2": "Medicamente aici.",
    "Stash_MulMap6_Text21": "Ține minte: antibiotice, bandaje. Piciorul nu se reface de la sine.",
    "Stash_MulMap6_Text3": "SAW A HERD OF THEM HEADED THIS WAY. AVOID! LOVE YOU x",
    "Stash_MulMap7_Text1": "Planul B.",
    "Stash_MulMap7_Text2": "Magazin - ÎNCĂ PLIN",
    "Stash_MulMap7_Text3": "futut",
    "Stash_MulMap8_Text1": "Ia-mi lucrurile. Îngroapă-mă dacă poți și e sigur. Fii binecuvântat!",
    "Stash_MulMap8_Text2": "ia o băutură dacă ai nevoie",
    "Stash_MulMap8_Text3": "mulțime mare, nu s-a mișcat de câteva zile",
    "Stash_RosewoodStashMap2_Text1": "Am ascuns niște arme aici",
    "Stash_RosewoodStashMap2_Text2": "următorul aici",
    "Stash_RosewoodStashMap2_Text3": "se termină chiar aici",
    "Stash_RosewoodStashMap3_Text1": "Am fost și am găsit niște unelte care ne vor ajuta să fortificăm locul cât timp așteptăm.",
    "Stash_RosewoodStashMap3_Text11": "Locuința veche a mamei. Ne vedem acolo x",
    "Stash_RosewoodStashMap3_Text2": "pot fi arme aici - în caz de ceva",
    "Stash_RosewoodStashMap3_Text3": "nu veni pe aici",
    "Stash_WpMap10_Text2": "poate că magazinul de bricolaj mai are ceva în el",
    "Stash_WpMap10_Text3": "mai multe probleme",
    "Stash_WpMap11_Text1": "Managerul lui Spiffo's obișnuia să păstreze o pușcă în magazin.",
    "Stash_WpMap11_Text11": "Nebunul ăsta nenorocit știa ce urmează să se întample.",
    "Stash_WpMap11_Text2": "Magazinul de bricolaj neatins.",
    "Stash_WpMap11_Text3": "o să evit oriunde aproape de casă - nu mă căuta",
    "Stash_WpMap12_Text1": "toată lumea a fost prezentă la birou în ziua în care febra a lovit",
    "Stash_WpMap12_Text11": "I-am închis dinainte să se transforme",
    "Stash_WpMap12_Text2": "magazin de arme",
    "Stash_WpMap12_Text3": "mulțimi ca de Black Friday",
    "Stash_WpMap1_Text1": "Sigur aici a trăit el",
    "Stash_WpMap1_Text2": "mult prea mulți pentru a ne descurca, nu trage pe aici la dracu;",
    "Stash_WpMap2_Text1": "cred că locuia aici",
    "Stash_WpMap2_Text2": "clinică",
    "Stash_WpMap2_Text3": "am văzut-o mergând pe aici, nu avea nicio armă",
    "Stash_WpMap4_Text1": "Fii curajos. Te iubesc.",
    "Stash_WpMap4_Text3": "NU VENI AICI. Megan e pe undeva pe aici - e una dintre ei.",
    "Stash_WpMap4_Text31": "Nici nu știam că e în oraș. Pur și simplu nu te duce",
    "Stash_WpMap5_Text1": "uneltele pe care ți le-am lăsat în dormitor îți vor da un avans -",
    "Stash_WpMap5_Text11": "ține-i afară atât timp cât poți TE IUBESC",
    "Stash_WpMap5_Text2": "pizza",
    "Stash_WpMap5_Text3": "pericol",
    "Stash_WpMap6_Text1": "Nu o să am nevoie de toate astea. Succes.",
    "Stash_WpMap6_Text2": "lui Twiggy",
    "Stash_WpMap8_Text1": "Jolene nu a luat boala. Ea poate ajuta.",
    "Stash_WpMap8_Text2": "Magazin de arme",
    "Stash_WpMap8_Text3": "am văzut un tip murind",
    "Stash_WpMap9_Text1": "ZOMBI HELL HOLE",
    "Stash_WpMap9_Text2": "biroul tatălui",
    "Stash_WpMap9_Text3": "corpul tatălui",
